  "components": {
    "responses": {
      "InvalidParameter": {
        "description": "A parameter is missing or malformed. `parameter` names it.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "example": {
              "type": "https://www.eporner.com/api/v2/#error-invalid-parameter",
              "title": "Invalid parameter",
              "status": 400,
              "detail": "since must be a Unix timestamp, a date (YYYY-MM-DD) or an RFC 3339 date-time.",
              "parameter": "since"
            }
          }
        }
      },
      "NotFound": {
        "description": "There is no such video or method.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "example": {
              "type": "https://www.eporner.com/api/v2/#error-not-found",
              "title": "Not found",
              "status": 404,
              "detail": "There is no video at this address."
            }
          }
        }
      },
      "Unavailable": {
        "description": "The request could not be answered right now. Wait for the time in `Retry-After` and try again; do not treat it as an empty result.",
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "integer"
            },
            "description": "Seconds to wait."
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "example": {
              "type": "https://www.eporner.com/api/v2/#error-unavailable",
              "title": "Temporarily unavailable",
              "status": 503,
              "detail": "The request could not be answered right now. Try again in half a minute."
            }
          }
        }
      },
      "MethodNotAllowed": {
        "description": "The method is read with GET (or HEAD). `Allow` lists what it accepts. The search and id methods also answer POST, as they always have.",
        "headers": {
          "Allow": {
            "schema": {
              "type": "string"
            },
            "description": "The HTTP methods the address accepts."
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "example": {
              "type": "https://www.eporner.com/api/v2/#error-method-not-allowed",
              "title": "Method not allowed",
              "status": 405,
              "detail": "Use GET."
            }
          }
        }
      },
      "FormatNotImplemented": {
        "description": "A format other than JSON was asked for.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "example": {
              "type": "https://www.eporner.com/api/v2/#error-format-not-implemented",
              "title": "Format not implemented",
              "status": 501,
              "detail": "oEmbed replies are available as JSON only."
            }
          }
        }
      }
