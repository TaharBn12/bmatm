                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidParameter"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/oembed/": {
      "get": {
        "operationId": "getOembed",
        "tags": [
          "Embedding"
        ],
        "summary": "oEmbed",
        "description": "Returns the player for a video address in the oEmbed 1.0 format (type `video`), sized to fit `maxwidth` and `maxheight`. For VR videos, the iframe delegates `xr-spatial-tracking` so headset users can enter immersive mode.",
        "x-anchor": "oembed",
        "x-example": {
          "url": "https://www.eporner.com/video-AbCdEfGhIjK/sample-title/",
          "maxwidth": 640
        },
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "description": "The address of a video page or of its player on eporner.com, on any of its language hosts.",
            "schema": {
              "type": "string",
              "format": "uri"
            },
            "required": true,
            "example": "https://www.eporner.com/video-AbCdEfGhIjK/sample-title/"
          },
          {
            "name": "maxwidth",
            "in": "query",
            "description": "The widest player you can show, in pixels. Without it the player is at most 1280 wide.",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 640
          },
          {
            "name": "maxheight",
            "in": "query",
            "description": "The tallest player you can show, in pixels.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "Only `json` is offered; any other value is answered with 501.",
            "schema": {
              "type": "string",
              "enum": [
                "json"
              ],
              "default": "json"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The oEmbed reply.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Oembed"
                },
                "example": {
                  "version": "1.0",
                  "type": "video",
                  "provider_name": "Eporner",
                  "provider_url": "https://www.eporner.com/",
                  "title": "Sample title",
                  "html": "<iframe src=\"https://www.eporner.com/embed/AbCdEfGhIjK/\" width=\"640\" height=\"360\" frameborder=\"0\" scrolling=\"no\" allowfullscreen></iframe>",
                  "width": 640,
                  "height": 360,
                  "thumbnail_url": "https://static-ca-cdn.eporner.com/thumbs/static4/5/50/500/5000001/5_360.jpg",
                  "thumbnail_width": 640,
                  "thumbnail_height": 360
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidParameter"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "501": {
            "$ref": "#/components/responses/FormatNotImplemented"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/openapi/": {
      "get": {
        "operationId": "getOpenapi",
        "tags": [
          "Lists"
        ],
