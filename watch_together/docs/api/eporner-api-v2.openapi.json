    "schemas": {
      "Thumbnail": {
        "type": "object",
        "required": [
          "size",
          "width",
          "height",
          "src"
        ],
        "properties": {
          "size": {
            "type": "string",
            "enum": [
              "small",
              "medium",
              "big"
            ],
            "description": "The size asked for."
          },
          "width": {
            "type": "integer",
            "description": "Width in pixels."
          },
          "height": {
            "type": "integer",
            "description": "Height in pixels."
          },
          "src": {
            "type": "string",
            "format": "uri",
            "description": "The image address."
          }
        }
      },
      "Category": {
        "type": "object",
        "required": [
          "id",
          "name",
          "slug",
          "url"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "description": "The category's number."
          },
          "name": {
            "type": "string",
            "description": "English name."
          },
          "slug": {
            "type": "string",
            "description": "The name as it appears in addresses."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "The category page."
          }
        }
      },
      "PornstarRef": {
        "type": "object",
        "required": [
          "id",
          "name",
          "url"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "description": "The performer's number."
          },
          "name": {
            "type": "string",
            "description": "Name."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "The performer's page."
          }
        }
      },
      "Pornstar": {
        "type": "object",
        "required": [
          "id",
          "name",
          "url",
          "gender",
          "videos",
          "photos"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "description": "The performer's number."
          },
          "name": {
            "type": "string",
            "description": "Name."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "The performer's page."
          },
          "gender": {
            "type": "string",
            "enum": [
              "female",
              "male"
            ],
            "description": "Gender as listed in the directory."
          },
          "videos": {
            "type": "integer",
            "description": "Number of videos."
          },
          "photos": {
            "type": "integer",
            "description": "Number of photos."
          }
        }
      },
      "Quality": {
        "type": "object",
        "required": [
          "max",
          "available",
          "hd",
          "fps",
          "vr"
        ],
        "properties": {
          "max": {
            "type": [
              "string",
              "null"
            ],
            "description": "The best quality the player offers, for example `1080p`; `null` when unknown."
          },
          "available": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "240p",
                "360p",
                "480p",
                "720p",
                "1080p",
                "1440p",
                "2160p"
              ]
            },
            "description": "Every quality the player offers, lowest first. A quality counts when the video has it in H.264 or in AV1."
          },
          "hd": {
            "type": "boolean",
            "description": "True from 720p up."
          },
          "fps": {
            "type": "integer",
            "description": "Frames per second; 0 when unknown."
          },
          "vr": {
            "type": "boolean",
            "description": "True for a VR video."
          }
        }
      },
      "Translation": {
        "type": [
          "object",
          "null"
        ],
        "required": [
          "lang",
          "title"
        ],
        "properties": {
          "lang": {
            "type": "string",
            "description": "The language asked for."
          },
          "title": {
            "type": "string",
            "description": "The title in that language."
          }
        }
      },
      "Video": {
        "type": "object",
        "required": [
          "id",
          "title",
          "keywords",
          "views",
          "rate",
          "url",
          "added",
          "length_sec",
          "length_min",
          "embed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The video id: 11 letters and digits, case-sensitive."
          },
          "title": {
            "type": "string",
            "description": "Title, UTF-8."
          },
          "keywords": {
            "type": "string",
            "description": "Keywords, separated by commas."
          },
          "views": {
            "type": "integer",
            "description": "Estimated number of views."
          },
          "rate": {
            "type": "string",
            "description": "Rating from `0.00` to `5.00`, as a string with two decimals."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "The video page. Link to this address."
          },
          "added": {
            "type": "string",
            "description": "When the video was added: `YYYY-MM-DD hh:mm:ss` in Central European time, without an offset."
          },
          "length_sec": {
            "type": "integer",
            "description": "Length in seconds."
          },
          "length_min": {
            "type": "string",
            "description": "Length as `m:ss`. Minutes are not folded into hours: 2 h 5 min 30 s is `125:30`."
          },
          "embed": {
            "type": "string",
            "format": "uri",
            "description": "The player address, for the `src` of an iframe."
          },
          "default_thumb": {
            "$ref": "#/components/schemas/Thumbnail",
            "description": "The thumbnail the site shows. Left out with `thumbs=none`."
          },
          "thumbs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Thumbnail"
            },
            "description": "Fifteen thumbnails from across the video. Only with `thumbs=all`."
          },
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Category"
            },
            "description": "Only with `fields=categories`."
          },
          "pornstars": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PornstarRef"
            },
            "description": "Only with `fields=pornstars`."
          },
          "quality": {
            "$ref": "#/components/schemas/Quality",
            "description": "Only with `fields=quality`."
          },
          "translation": {
            "$ref": "#/components/schemas/Translation",
            "description": "Only with `lang`: the translated title, or `null`."
          }
        }
      },
      "SearchResult": {
        "type": "object",
        "required": [
          "count",
          "start",
          "per_page",
          "page",
          "time_ms",
          "total_count",
          "total_pages",
          "videos"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "description": "Videos in this reply."
          },
          "start": {
            "type": "integer",
            "description": "Position of the first video of this page: `per_page * (page - 1)`."
          },
          "per_page": {
            "type": "integer",
            "description": "Videos per page, as used."
          },
          "page": {
            "type": "integer",
            "description": "This page's number."
          },
          "time_ms": {
            "type": "integer",
            "description": "Time the request took on the server, in milliseconds."
          },
          "total_count": {
            "type": "integer",
            "description": "Videos that match, up to 100,000 for a search or a listing narrowed by length or date."
          },
          "total_pages": {
            "type": "integer",
            "description": "Pages there are with this `per_page`. Stop here; do not stop because a page is shorter than `per_page`."
          },
          "videos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Video"
            },
            "description": "The videos of this page."
          }
        }
      },
      "RemovedList": {
        "type": "object",
        "required": [
          "since",
          "count",
          "has_more",
          "removed"
        ],
        "properties": {
          "since": {
            "type": "string",
            "format": "date-time",
            "description": "The moment this reply starts from."
          },
          "count": {
            "type": "integer",
            "description": "Entries in this reply."
          },
          "has_more": {
            "type": "boolean",
            "description": "True when more entries follow."
          },
          "next": {
            "type": "string",
            "description": "Pass as `after` to continue. Present when `has_more` is true."
          },
          "removed": {
            "type": "array",
            "description": "Removed videos, oldest removal first.",
            "items": {
              "type": "object",
              "required": [
                "id",
                "removed_at"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The video id."
                },
                "removed_at": {
                  "type": "string",
                  "format": "date-time",
                  "description": "When it was removed, UTC."
                }
              }
            }
          }
        }
      },
      "StatusList": {
        "type": "object",
        "required": [
          "count",
          "videos"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "description": "Entries in this reply."
          },
          "videos": {
            "type": "array",
            "description": "One entry per id asked, in the order asked.",
            "items": {
              "type": "object",
              "required": [
                "id",
                "status"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The id as asked."
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "active",
                    "removed",
                    "unavailable",
                    "unknown"
                  ],
                  "description": "`active`: can be watched. `removed`: removed for good; drop it. `unavailable`: not playable right now. `unknown`: no video has this id."
                },
                "removed_at": {
                  "type": "string",
                  "format": "date-time",
                  "description": "When it was removed, UTC. Only for `removed`."
                }
              }
            }
          }
        }
      },
      "CategoryList": {
        "type": "object",
        "required": [
          "count",
          "categories"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "description": "Number of categories."
          },
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Category"
            },
            "description": "All categories."
          }
        }
      },
      "PornstarList": {
        "type": "object",
        "required": [
          "count",
          "page",
          "per_page",
          "total_count",
          "total_pages",
          "pornstars"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "description": "Performers in this reply."
          },
          "page": {
            "type": "integer",
            "description": "This page's number."
          },
          "per_page": {
            "type": "integer",
            "description": "Performers per page."
          },
          "total_count": {
            "type": "integer",
            "description": "Performers in the directory."
          },
          "total_pages": {
            "type": "integer",
            "description": "Pages there are with this `per_page`."
          },
          "pornstars": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Pornstar"
            },
            "description": "The performers of this page."
          }
        }
      },
      "Oembed": {
        "type": "object",
        "required": [
          "version",
          "type",
          "provider_name",
          "provider_url",
          "title",
          "html",
          "width",
          "height"
        ],
        "properties": {
          "version": {
            "type": "string",
            "const": "1.0",
            "description": "The oEmbed version."
          },
          "type": {
            "type": "string",
            "const": "video",
            "description": "Always `video`."
          },
          "provider_name": {
            "type": "string",
            "description": "Eporner."
          },
          "provider_url": {
            "type": "string",
            "format": "uri",
            "description": "The site's address."
          },
          "title": {
            "type": "string",
            "description": "The video's title."
          },
          "html": {
            "type": "string",
            "description": "The markup to place on your page: an iframe with the player."
          },
          "width": {
            "type": "integer",
            "description": "Player width in pixels."
          },
          "height": {
            "type": "integer",
            "description": "Player height in pixels."
          },
          "thumbnail_url": {
            "type": "string",
            "format": "uri",
            "description": "A thumbnail for the video."
          },
          "thumbnail_width": {
            "type": "integer",
            "description": "Thumbnail width."
          },
          "thumbnail_height": {
            "type": "integer",
            "description": "Thumbnail height."
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "An error in the RFC 9457 format.",
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri",
            "description": "Identifies the kind of error; the address leads to its description."
          },
          "title": {
            "type": "string",
            "description": "The kind of error in words."
          },
          "status": {
            "type": "integer",
            "description": "The HTTP status code."
          },
          "detail": {
            "type": "string",
            "description": "What was wrong with this request."
          },
          "parameter": {
            "type": "string",
            "description": "The parameter at fault, for an invalid parameter."
          }
        }
      }
    }
  }
}
