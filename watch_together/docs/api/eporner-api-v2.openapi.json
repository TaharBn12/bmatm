{
  "openapi": "3.1.0",
  "info": {
    "title": "Eporner API",
    "version": "2.1.0",
    "summary": "Video listings, single videos, removed videos and reference lists for sites and apps that link to or embed Eporner videos.",
    "description": "All methods are read with HTTP GET and need no key. Replies are JSON; the search and id methods also offer XML. See https://www.eporner.com/api/v2/ for limits, errors and terms of use.",
    "termsOfService": "https://www.eporner.com/api/v2/#terms",
    "contact": {
      "name": "Eporner support",
      "url": "https://www.eporner.com/contact/"
    }
  },
  "servers": [
    {
      "url": "https://www.eporner.com/api/v2"
    }
  ],
  "externalDocs": {
    "description": "Documentation",
    "url": "https://www.eporner.com/api/v2/"
  },
  "tags": [
    {
      "name": "Videos",
      "description": "Find videos and read one video."
    },
    {
      "name": "Removed videos",
      "description": "Keep your copy free of videos that were removed."
    },
    {
      "name": "Lists",
      "description": "Categories and performers."
    },
    {
      "name": "Embedding",
      "description": "The player for a video address."
    }
  ],
  "paths": {
    "/video/search/": {
      "get": {
        "operationId": "searchVideos",
        "tags": [
          "Videos"
        ],
        "summary": "Search videos",
        "description": "Returns one page of videos that match a search, or of all videos. A search, and a listing of all videos narrowed by length or date, reaches its first 100,000 results; the plain listing of all videos has no such limit. The first page of a search can be about ten minutes old, deeper pages about two hours.",
        "x-anchor": "search",
        "x-example": {
          "query": "yoga",
          "per_page": 2,
          "order": "most-popular",
          "thumbs": "default"
        },
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "description": "Search words in any script, for example `yoga` or `yoga outdoor`. Every word must match. Punctuation and search operators are ignored. `all` (the default) lists every video.",
            "schema": {
              "type": "string",
              "default": "all"
            },
            "example": "yoga"
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Videos per page. Values outside 1 to 1000 are moved to the nearest end.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 30
            },
            "example": 30
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number, from 1 to `total_pages`. A page past the end is an empty page.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "example": 1
          },
          {
            "name": "order",
            "in": "query",
            "description": "Sort order: `latest` newest first, `longest` and `shortest` by length, `top-rated` by rating, `most-popular` by all-time views, `top-weekly` and `top-monthly` by views in the last week or month.",
            "schema": {
              "type": "string",
              "enum": [
                "latest",
                "longest",
                "shortest",
                "top-rated",
                "most-popular",
                "top-weekly",
                "top-monthly"
              ],
              "default": "latest"
            },
            "example": "latest"
          },
          {
            "name": "gay",
            "in": "query",
            "description": "Gay content: `0` leaves it out, `1` includes it, `2` returns only gay content.",
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1,
                2
              ],
              "default": 0
            }
          },
          {
            "name": "lq",
            "in": "query",
            "description": "Content marked as low quality: `0` leaves it out, `1` includes it, `2` returns only low quality.",
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1,
                2
              ],
              "default": 1
            }
          },
          {
            "name": "min_duration",
            "in": "query",
            "description": "Shortest length in seconds.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400
            },
            "example": 300
          },
          {
            "name": "max_duration",
            "in": "query",
            "description": "Longest length in seconds.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400
            },
            "example": 1800
          },
          {
            "name": "added_after",
            "in": "query",
            "description": "Only videos published at or after this moment: a date (`YYYY-MM-DD`, midnight UTC), an RFC 3339 date-time or a Unix timestamp. A fraction of a second counts as the next whole second.",
            "schema": {
              "type": "string",
              "example": "2026-11-01"
            }
          },
          {
            "name": "added_before",
            "in": "query",
            "description": "Only videos published before this moment, in the same forms.",
            "schema": {
              "type": "string",
              "example": "2026-11-15"
            }
          },
          {
            "name": "thumbsize",
            "in": "query",
            "description": "Thumbnail size: `small` fits 190x152, `medium` 427x240, `big` 640x360. The real width and height are in each thumbnail entry.",
            "schema": {
              "type": "string",
              "enum": [
                "small",
                "medium",
                "big"
              ],
              "default": "medium"
            },
            "example": "medium"
          },
          {
            "name": "thumbs",
            "in": "query",
            "description": "Which thumbnails each video carries: `all` is the default thumbnail and the list of fifteen, `default` only the default thumbnail, `none` no thumbnails. The list of fifteen is about three quarters of a reply, so ask for `default` when you show one image per video.",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "default",
                "none"
              ],
              "default": "all"
            },
            "example": "default"
          },
          {
            "name": "fields",
            "in": "query",
            "description": "Extra fields per video, separated by commas: `categories`, `pornstars`, `quality`. Each one costs a little time, so ask only for what you use.",
            "schema": {
              "type": "string",
              "example": "categories,pornstars,quality"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "description": "Adds `translation`: the title in this language, or `null` where there is none. Titles exist in `pl`, `fr` and `es`.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z]{2}$",
              "example": "pl"
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "Reply format.",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "xml"
              ],
              "default": "json"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of videos. Malformed parameters are replaced by their defaults, so this method does not answer 400.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResult"
                },
                "example": {
                  "count": 2,
                  "start": 0,
                  "per_page": 2,
                  "page": 1,
                  "time_ms": 6,
                  "total_count": 11626,
                  "total_pages": 5813,
                  "videos": [
                    {
                      "id": "AbCdEfGhIjK",
                      "title": "Sample title",
                      "keywords": "outdoor, garden, sample",
                      "views": 260221,
                      "rate": "4.13",
                      "url": "https://www.eporner.com/video-AbCdEfGhIjK/sample-title/",
                      "added": "2026-11-17 21:41:44",
                      "length_sec": 2539,
                      "length_min": "42:19",
                      "embed": "https://www.eporner.com/embed/AbCdEfGhIjK/",
                      "default_thumb": {
                        "size": "medium",
                        "width": 427,
                        "height": 240,
                        "src": "https://static-ca-cdn.eporner.com/thumbs/static4/5/50/500/5000001/5_240.jpg"
                      }
                    },
                    {
                      "id": "LmNoPqRsTuV",
                      "title": "Another sample",
                      "keywords": "outdoor, garden, sample",
                      "views": 18400,
                      "rate": "3.92",
                      "url": "https://www.eporner.com/video-LmNoPqRsTuV/another-sample/",
                      "added": "2026-11-17 21:41:44",
                      "length_sec": 2539,
                      "length_min": "42:19",
                      "embed": "https://www.eporner.com/embed/LmNoPqRsTuV/",
                      "default_thumb": {
                        "size": "medium",
                        "width": 427,
                        "height": 240,
                        "src": "https://static-ca-cdn.eporner.com/thumbs/static4/5/50/500/5000001/5_240.jpg"
                      }
                    }
                  ]
                }
              },
              "text/xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/video/id/": {
      "get": {
        "operationId": "getVideo",
        "tags": [
          "Videos"
        ],
        "summary": "Get one video",
        "description": "Returns one video by its id. A video that was removed, is not playable or never existed gives an empty reply: `[]` in JSON. A 503 is not that reply: it means the video could not be looked up. To check many ids at once, use the status method.",
        "x-anchor": "id",
        "x-example": {
          "id": "AbCdEfGhIjK",
          "thumbs": "default"
        },
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "description": "The video id: 11 letters and digits, case-sensitive.",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]{11}$"
            },
            "required": true,
            "example": "AbCdEfGhIjK"
          },
          {
            "name": "thumbsize",
            "in": "query",
            "description": "Thumbnail size: `small` fits 190x152, `medium` 427x240, `big` 640x360. The real width and height are in each thumbnail entry.",
            "schema": {
              "type": "string",
              "enum": [
                "small",
                "medium",
                "big"
              ],
              "default": "medium"
            },
            "example": "medium"
          },
          {
            "name": "thumbs",
            "in": "query",
            "description": "Which thumbnails each video carries: `all` is the default thumbnail and the list of fifteen, `default` only the default thumbnail, `none` no thumbnails. The list of fifteen is about three quarters of a reply, so ask for `default` when you show one image per video.",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "default",
                "none"
              ],
              "default": "all"
            },
            "example": "default"
          },
          {
            "name": "fields",
            "in": "query",
            "description": "Extra fields per video, separated by commas: `categories`, `pornstars`, `quality`. Each one costs a little time, so ask only for what you use.",
            "schema": {
              "type": "string",
              "example": "categories,pornstars,quality"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "description": "Adds `translation`: the title in this language, or `null` where there is none. Titles exist in `pl`, `fr` and `es`.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z]{2}$",
              "example": "pl"
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "Reply format.",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "xml"
              ],
              "default": "json"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The video, or an empty array when there is no such video.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Video"
                    },
                    {
                      "type": "array",
                      "maxItems": 0
                    }
                  ]
                },
                "example": {
                  "id": "AbCdEfGhIjK",
                  "title": "Sample title",
                  "keywords": "outdoor, garden, sample",
                  "views": 260221,
                  "rate": "4.13",
                  "url": "https://www.eporner.com/video-AbCdEfGhIjK/sample-title/",
                  "added": "2026-11-17 21:41:44",
                  "length_sec": 2539,
                  "length_min": "42:19",
                  "embed": "https://www.eporner.com/embed/AbCdEfGhIjK/",
                  "default_thumb": {
                    "size": "medium",
                    "width": 427,
                    "height": 240,
                    "src": "https://static-ca-cdn.eporner.com/thumbs/static4/5/50/500/5000001/5_240.jpg"
                  }
                }
              },
              "text/xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/video/removed/": {
      "get": {
        "operationId": "listRemovedVideos",
        "tags": [
          "Removed videos"
        ],
        "summary": "Removed videos",
        "description": "With `since`, returns the videos removed from that moment on, oldest removal first, up to 1000 per reply. Read the reply, store `next`, and pass it as `after` to continue; when `has_more` is false you are up to date. Without `since` and `after` the reply is a redirect to the complete list of removed ids as one file, which is rebuilt about once a day.",
        "x-anchor": "removed",
        "x-example": {
          "since": "2026-11-17T00:00:00Z",
          "per_page": 2
        },
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "description": "Removals at or after this moment: an RFC 3339 date-time, a date (`YYYY-MM-DD`, midnight UTC) or a Unix timestamp. A fraction of a second counts as the next whole second.",
            "schema": {
              "type": "string"
            },
            "example": "2026-11-17T00:00:00Z"
          },
          {
            "name": "after",
            "in": "query",
            "description": "The `next` value of the previous reply. Continues the listing right after its last entry; `since` is then not needed.",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{1,10}\\.[0-9]{1,10}$"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Entries per reply.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 1000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Removed videos, oldest removal first.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RemovedList"
                },
                "example": {
                  "since": "2026-11-17T00:00:00Z",
                  "count": 2,
                  "has_more": true,
                  "next": "1794873600.18200456",
                  "removed": [
                    {
                      "id": "AbCdEfGhIjK",
                      "removed_at": "2026-11-17T00:00:00Z"
                    },
                    {
                      "id": "LmNoPqRsTuV",
                      "removed_at": "2026-11-17T00:04:12Z"
                    }
                  ]
                }
              }
            }
          },
          "302": {
            "description": "Without `since` and `after`: a redirect to the complete list, one id per line.",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidParameter"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/video/status/": {
      "get": {
        "operationId": "getVideoStatus",
        "tags": [
          "Removed videos"
        ],
        "summary": "Check video status",
        "description": "Tells for up to 100 ids at once whether each video can still be watched. One request replaces up to 100 calls of the id method.",
        "x-anchor": "status",
        "x-example": {
          "id": "AbCdEfGhIjK,LmNoPqRsTuV"
        },
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "description": "One to 100 video ids, separated by commas.",
            "schema": {
              "type": "string"
            },
            "required": true,
            "example": "AbCdEfGhIjK,LmNoPqRsTuV"
          }
        ],
        "responses": {
          "200": {
            "description": "One entry per id asked, in the order asked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusList"
                },
                "example": {
                  "count": 2,
                  "videos": [
                    {
                      "id": "AbCdEfGhIjK",
                      "status": "active"
                    },
                    {
                      "id": "LmNoPqRsTuV",
                      "status": "removed",
                      "removed_at": "2026-11-17T00:04:12Z"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidParameter"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/categories/": {
      "get": {
        "operationId": "listCategories",
        "tags": [
          "Lists"
        ],
        "summary": "Categories",
        "description": "All categories. The `categories` field of a video uses the same entries.",
        "x-anchor": "categories",
        "x-example": {},
        "parameters": [],
        "responses": {
          "200": {
            "description": "The category list.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryList"
                },
                "example": {
                  "count": 2,
                  "categories": [
                    {
                      "id": 49,
                      "name": "Outdoor",
                      "slug": "outdoor",
                      "url": "https://www.eporner.com/cat/outdoor/"
                    },
                    {
                      "id": 18,
                      "name": "Massage",
                      "slug": "massage",
                      "url": "https://www.eporner.com/cat/massage/"
                    }
                  ]
                }
              }
            }
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          }
        }
      }
    },
    "/pornstars/": {
      "get": {
        "operationId": "listPornstars",
        "tags": [
          "Lists"
        ],
        "summary": "Pornstars",
        "description": "The performer directory, most popular first. The `pornstars` field of a video uses the same ids.",
        "x-anchor": "pornstars",
        "x-example": {
          "per_page": 2
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Performers per page.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of performers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PornstarList"
                },
